
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x0020000
   data (!RX) : ORIGIN = 0x7C400, LENGTH = 0x3C00
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0x400; /* stack */
. = 0x40400;
C_L1L2_0_2_buff_0 = .;
. += 0x2000;
. = 0x42400;
C_L1L2_0_2_buff_1 = .;
. += 0x2000;
. = 0x44400;
B_L2L1_0_2_cons_buff_0 = .;
. += 0x2000;
. = 0x46400;
B_L2L1_0_2_cons_buff_1 = .;
. += 0x2000;
. = 0x48400;
A_L2L1_2_0_cons_buff_0 = .;
. += 0x2000;
. = 0x4A400;
A_L2L1_2_0_cons_buff_1 = .;
. += 0x2000;
/* No tile with memory exists to the west. */
. = 0x50000;
. += 0x10000;
/* No tile with memory exists to the north. */
. = 0x60000;
. += 0x10000;
. = 0x70400;
C_L1L2_0_3_buff_0 = .;
. += 0x2000;
. = 0x72400;
C_L1L2_0_3_buff_1 = .;
. += 0x2000;
. = 0x74400;
B_L2L1_0_3_cons_buff_0 = .;
. += 0x2000;
. = 0x76400;
B_L2L1_0_3_cons_buff_1 = .;
. += 0x2000;
. = 0x78400;
A_L2L1_3_0_cons_buff_0 = .;
. += 0x2000;
. = 0x7A400;
A_L2L1_3_0_cons_buff_1 = .;
. += 0x2000;
  .bss : { *(.bss*) } > data
}
INPUT(mm_64x64x64.o)
PROVIDE(main = core_0_5);
