subdir=matrix_vector
targetname=matrix_vector

# Currently does not accept reconfiguring size via these variables; must change
# in source at <targetname>.py as well as here
M?=288
K?=288
N=1
m=32
k=32

kernels=mv_${m}x${k}
use_placed?=0
use_iron?=0

ifeq (${use_placed}, 1)
aie_py_src=${targetname}_placed.py
ifeq (${use_iron}, 1)
$(error Cannot specify both placed design and IRON)
endif
endif

ifeq (${use_iron}, 1)
aie_py_src=${targetname}_iron.py
endif


SELF_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
include ${SELF_DIR}../makefile-common

kernels_dir=${srcdir}/../../../../aie_kernels/aie2

build/mv_${m}x${k}.o: ${kernels_dir}/mv.cc
	mkdir -p ${@D}
ifeq (${devicename}, npu)
	cd ${@D} && ${PEANO_INSTALL_DIR}/bin/clang++ ${PEANOWRAP2_FLAGS} -DBIT_WIDTH=8 -DDIM_M=${m} -DDIM_K=${k} -c $< -o ${@F}
else ifeq (${devicename}, npu2)
	cd ${@D} && ${PEANO_INSTALL_DIR}/bin/clang++ ${PEANOWRAP2P_FLAGS} -DBIT_WIDTH=8 -DDIM_M=${m} -DDIM_K=${k} -c $< -o ${@F}
endif
rm -rf tmpTrace parse*.json trace*json trace.txt
rm -rf build _build matrix_vector.exe
mkdir -p build
python3 /home/adam/mlir-aie/programming_examples/basic/matrix_multiplication/matrix_vector/matrix_vector.py --dev npu -M 256 -K 256 -N 1 --dtype_in i16 --dtype_out i16 --trace_size 0 > build/aie_256x256x1.mlir
mkdir -p build
cd build && /home/adam/mlir-aie/ironenv/lib/python3.12/site-packages/llvm-aie/bin/clang++ -O2 -std=c++20 --target=aie2-none-unknown-elf -Wno-parentheses -Wno-attributes -Wno-macro-redefined -Wno-empty-body -DNDEBUG -I /home/adam/mlir-aie/ironenv/lib/python3.12/site-packages/mlir_aie/include  -DBIT_WIDTH=8 -DDIM_M=32 -DDIM_K=32 -c /home/adam/mlir-aie/programming_examples/basic/matrix_multiplication/matrix_vector/../../../../aie_kernels/aie2/mv.cc -o mv_32x32.o
mkdir -p build
cd build && aiecc.py --alloc-scheme=basic-sequential --aie-generate-xclbin --no-compile-host --xclbin-name=final_256x256x1.xclbin \
			 --no-xchesscc --no-xbridge --peano /home/adam/mlir-aie/ironenv/lib/python3.12/site-packages/llvm-aie \
			--aie-generate-npu-insts --npu-insts-name=insts_256x256x1.txt ../build/aie_256x256x1.mlir


